algoritmo "MenuLanchonete"

var
  opcao: inteiro

inicio
  escreval("1 - Hambúrguer | 2 - Pizza | 3 - Salada | 4 - Sair")
  leia(opcao)

  escolha opcao
    caso 1
      escreval("Preparando Hambúrgue...")
    caso 2
      escreval("Assando Pizza...")
    caso 3
      escreval("Cortando Salada...")
    caso 4
      escreval("Saindo...")
  fimescolha

fimalgoritmo